# Base URL of the HYG.3 API server (server/index.ts), no trailing /v1.
# On a physical device or simulator this must be reachable from that
# device — "localhost" only works in the iOS Simulator, not on Android
# emulators or real devices. Use your machine's LAN IP instead, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
