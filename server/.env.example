DATABASE_URL="postgresql://user:password@host:5432/dbname"
GEMINI_API_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN="http://localhost:5173"

# WHOOP OAuth 2.0 — register a free developer app at https://developer.whoop.com
# to get these. Until both are set, wearable connect is disabled (the
# frontend shows a "not configured" state instead of failing silently).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the WHOOP developer app.
WHOOP_REDIRECT_URI="http://localhost:3000/v1/wearables/whoop/callback"
